# Skopiuj do `.env` w katalogu głównym i dostosuj wartości.
# Lokalny development (uvicorn na hoście, bazy w Dockerze):
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
CHROMA_HOST=localhost
CHROMA_PORT=8001
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_COLLECTION_NAME=corporate_rag_chunks

# Document ingest (paths relative to backend cwd unless absolute)
UPLOAD_DIR=data/uploads
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=26214400

# Gdy backend działa w docker-compose, użyj hostów sieciowych:
# DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
# CHROMA_HOST=chroma
# CHROMA_PORT=8000
# OLLAMA_BASE_URL=http://ollama:11434
